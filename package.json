{
  "name": "n8n-nodes-everycore-sage100",
  "version": "0.1.0",
  "description": "n8n nodes for everycore Core for Sage 100: sales documents, transactions and articles",
  "keywords": [
    "n8n-community-node-package",
    "sage",
    "sage100",
    "erp",
    "everycore",
    "n8n",
    "automation",
    "wawi",
    "germany"
  ],
  "license": "MIT",
  "homepage": "https://everycore.net",
  "author": {
    "name": "everycore",
    "email": "info@everycore.net",
    "url": "https://everycore.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everycore-net/n8n-nodes-everycore-sage100.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build && node tools/copy-translations.mjs",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run",
    "test:watch": "vitest",
    "translations": "node tools/generate-translations.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/Sage100CoreApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Sage100/Sage100.node.js",
      "dist/nodes/Sage100Trigger/Sage100Trigger.node.js",
      "dist/nodes/Sage100PollTrigger/Sage100PollTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.47.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/everycore-net/n8n-nodes-everycore-sage100/issues"
  }
}
